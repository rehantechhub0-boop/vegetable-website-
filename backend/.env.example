# ==============================================================================
# MUZAFFARGARH FRESH VEGETABLE PLATFORM — BACKEND CONFIGURATION TEMPLATE
# Copy to .env (for local dev) or configure in hosting provider (Render, Railway, VPS)
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Node Environment: 'development', 'staging', or 'production'
NODE_ENV=staging

# Server Listening Port (Default: 5000)
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# Staging / Production (PostgreSQL):
# Standard PostgreSQL URL format with connection pooling and SSL options.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres_user:your_secure_db_password@staging-db.internal:5432/vegetables_staging?sslmode=require"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT Secret Key: REQUIRED. Must be a cryptographically secure random string >= 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_64_character_cryptographically_secure_random_hex_string"

# JWT Expiration duration (e.g., "7d", "24h")
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
# Allowed Client Origins for CORS (comma-separated list for multiple domains)
# In production/staging, only these exact origins will be permitted. Localhost is blocked.
CORS_ORIGIN="https://staging.freshvegetables.pk"

# Reverse Proxy Trust (Set to 'true' or '1' when deployed behind Nginx, Caddy, Cloudflare, AWS ALB)
# Ensures accurate client IP detection for rate limiting and prevents header spoofing.
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# RATE LIMITING (ABUSE & BRUTE-FORCE PROTECTION)
# ------------------------------------------------------------------------------
# Window duration in milliseconds for authentication rate limiter (default: 900000 = 15 minutes)
AUTH_RATE_WINDOW_MS=900000

# Maximum authentication requests allowed per window per IP (production default: 20)
AUTH_RATE_MAX=20

# ------------------------------------------------------------------------------
# STATIC ASSETS & STORAGE
# ------------------------------------------------------------------------------
# Directory for uploaded vegetable images and media
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (OPTIONAL / PLACEHOLDERS)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (leave blank if disabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://staging.freshvegetables.pk/login"

# WhatsApp Business Cloud API (leave blank if disabled)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ADMIN_PHONE="923001234567"
